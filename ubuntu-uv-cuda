# syntax=docker/dockerfile:1

# Image containing all basic applications for my CUDA development environment.
# This base image has the NVIDIA CUDA Toolkit, uv, and a series of command line
# applications I use.
# This image is very similar to the `ubuntu-uv` base image I use on other
# projects, it just derives from a different image, the `nvidia/cuda` image,
# that, in theory, derives from the same Ubuntu base, but already includes all
# NVIDIA development tools.

FROM nvidia/cuda:13.3.1-devel-ubuntu26.04

ARG BUILD_DATE
ARG VCS_REF
ARG IMAGE_VERSION

LABEL org.opencontainers.image.authors="Joao Aguirre" \
    org.opencontainers.image.source="https://github.com/joao-aguirre/docker-dev-images" \
    org.opencontainers.image.description="Ubuntu + CUDA + uv + CLI tools development container" \
    org.opencontainers.image.licenses="MIT" \
    org.opencontainers.image.created="${BUILD_DATE}" \
    org.opencontainers.image.revision="${VCS_REF}" \
    org.opencontainers.image.version="${IMAGE_VERSION}"

ENV LANG=C.UTF-8 \
    LC_ALL=C.UTF-8 \
    TERM=xterm-256color

# Copied from the official Astral uv page about Docker images available at:
# https://docs.astral.sh/uv/guides/integration/docker/#installing-uv
# Modified to install uv at /usr/local/bin.
COPY --from=ghcr.io/astral-sh/uv:0.12.7 /uv /uvx /usr/local/bin/

# Install Linux tools & uv dependencies. Here there are also system dependencies
# for NVIDIA CUDA, OptiX, and Newton tools.
# - openGL dependencies are required by environments that use PyVista
# - `libreadline8t64`, `libncursesw6`, and `libtinfo6` are required by `nnn`
# - `libglib2.0-0` (or `libglib2.0-0t64`) is a common requirement by OpenCV
# - `openjdk-21-jre-headless` is used by the LanguageTool server
# - `bubblewrap` is required by Codex
# - `xclip` is required by Neovim
RUN apt-get update && \
    DEBIAN_FRONTEND=noninteractive apt-get install \
        --assume-yes --no-install-recommends \
        ca-certificates curl zip unzip tar git git-lfs pkg-config \
        build-essential cmake ninja-build \
        libx11-dev libxcursor-dev libxi-dev libxinerama-dev libxrandr-dev \
        libx11-6 libgl1 libglx0 libegl1 libgles2 \
        libglx-mesa0 libgl1-mesa-dev libgl1-mesa-dri \
        freeglut3-dev mesa-common-dev mesa-utils xvfb \
        libxft2 libxrender1 libxext6 libxcursor1 libxinerama1 \
        libglib2.0-0 libreadline8t64 libncursesw6 libtinfo6 \
        bash-completion man-db bubblewrap tmux lsd bat fzf ripgrep fd-find \
        openjdk-21-jre-headless xclip && \
    rm -rf /var/lib/apt/lists/*

# Create the symlinks to bat and fd, since the installed versions on Ubuntu
# have different names.
RUN ln --symbolic /usr/bin/batcat /usr/local/bin/bat && \
    ln --symbolic /usr/bin/fdfind /usr/local/bin/fd && \
    uv generate-shell-completion bash \
        > /usr/share/bash-completion/completions/uv

# Create configuration folders for user ubuntu (avoids the issue with top level
# .config and .local folders being owned by the root user.
RUN mkdir --parents \
    /home/ubuntu/.config \
    /home/ubuntu/.local/share \
    && chown -R ubuntu:ubuntu \
    /home/ubuntu/.config \
    /home/ubuntu/.local

# Additional CLI tools that are not available on apt.
# Application versions and checksums.
# When updating a version, do not forget to update the file checksim as well.

# nnn: https://github.com/joao-aguirre/dev-binaries/releases
ARG NNN_VERSION=5.2
ARG NNN_SHA256="c96a5920d11c1ce079b4cc5224573a41172011f59238ef25d1dca3efc5bf43c9"

# f2: https://github.com/ayoisaiah/f2/releases
ARG F2_VERSION=2.2.2
ARG F2_SHA256="d44bca9d9a08721655e0fd4a3459f4c2b844abb896de3e6a74551e8bf5f51432"

# lazygit: https://github.com/jesseduffield/lazygit/releases
ARG LAZYGIT_VERSION=0.64.1
ARG LAZYGIT_SHA256="f8ea237c41f194cd799b48505518bfdaae4edf5a2ad6bd3d898e939785ee4532"

# chezmoi: https://github.com/twpayne/chezmoi/releases
ARG CHEZMOI_VERSION=2.72.0
ARG CHEZMOI_SHA256="0d6665b96c527d57fdc562bf19e808f80f48c2d977062c03e3e65c6b09eafbce"

# oh-my-posh: https://github.com/JanDeDobbeleer/oh-my-posh/releases
ARG OHMYPOSH_VERSION=30.9.0
ARG OHMYPOSH_SHA256="8ef4ffa6b219681ec36a1bfde724b915b7ead9ffb011ef217ad3516b35616a3e"

# neovim: https://github.com/neovim/neovim/releases
ARG NEOVIM_VERSION=0.12.5
ARG NEOVIM_SHA256="bce0f56eda1f1b1db6eee8f4133d7a38813ea07933837dd1777411ca384c6875"

# tree-sitter: https://github.com/tree-sitter/tree-sitter/releases
ARG TREESITTER_VERSION=0.26.13
ARG TREESITTER_SHA256="1b781c0dc1dfefea44b5db2ec2a58440fe9d006856c3f5b3fd9a17119d1138a2"

# LanguageTool: https://languagetool.org/download/
ARG LANGUAGETOOL_VERSION=6.6
ARG LANGUAGETOOL_SHA256="53600506b399bb5ffe1e4c8dec794fd378212f14aaf38ccef9b6f89314d11631"

# OpenAI Codex: https://github.com/openai/codex/releases
ARG CODEX_VERSION=0.150.1
ARG CODEX_PACKAGE_SHA256="00aba704f029f6dc0d948be407a756e0c97cc840132fd691353b2c6b0a505b17"

# Install nnn from dev-binaries. 
RUN curl --fail --silent --show-error --location \
        "https://github.com/joao-aguirre/dev-binaries/releases/download/nnn-v${NNN_VERSION}-gitstatus-nerd/nnn-${NNN_VERSION}-linux-x86_64.tar.gz" \
        --output /tmp/nnn.tar.gz && \
    printf "%s  %s\n" \
        "${NNN_SHA256}" \
        "/tmp/nnn.tar.gz" | sha256sum --check --strict && \
    tar --extract --gzip --file /tmp/nnn.tar.gz --directory /tmp && \
    install --mode 0755 \
        "/tmp/nnn-${NNN_VERSION}-linux-x86_64/bin/nnn" /usr/local/bin/nnn && \
    mkdir --parents /usr/local/share/nnn && \
    cp --archive \
        "/tmp/nnn-${NNN_VERSION}-linux-x86_64/share/nnn/." \
        /usr/local/share/nnn/ && \
    install \
        --mode 0644 \
        /usr/local/share/nnn/auto-completion/bash/nnn-completion.bash \
        /usr/share/bash-completion/completions/nnn && \
    rm --recursive --force /tmp/nnn.tar.gz \
        "/tmp/nnn-${NNN_VERSION}-linux-x86_64" && \
    nnn -V

# Install f2.
RUN curl --fail --silent --show-error --location \
        "https://github.com/ayoisaiah/f2/releases/download/v${F2_VERSION}/f2_${F2_VERSION}_linux_amd64.tar.gz" \
        --output /tmp/f2.tar.gz && \
    printf "%s  %s\n" \
        "${F2_SHA256}" \
        "/tmp/f2.tar.gz" | sha256sum --check --strict && \
    tar --extract --gzip --file /tmp/f2.tar.gz --directory /tmp && \
    install --mode 0755 /tmp/f2 /usr/local/bin/f2 && \
    curl --fail --silent --show-error --location \
        "https://raw.githubusercontent.com/ayoisaiah/f2/v${F2_VERSION}/scripts/completions/f2.bash" \
        --output /tmp/f2.bash && \
    install \
        --mode 0644 \
        /tmp/f2.bash \
        /usr/share/bash-completion/completions/f2 && \
    rm --force /tmp/f2.tar.gz /tmp/f2.bash && \
    f2 --version

# Install lazygit.
RUN curl --fail --silent --show-error --location \
        "https://github.com/jesseduffield/lazygit/releases/download/v${LAZYGIT_VERSION}/lazygit_${LAZYGIT_VERSION}_linux_x86_64.tar.gz" \
        --output /tmp/lazygit.tar.gz && \
    printf "%s  %s" \
        "${LAZYGIT_SHA256}" \
        "/tmp/lazygit.tar.gz" | sha256sum --check --strict && \
    tar --extract --gzip --file /tmp/lazygit.tar.gz --directory /tmp && \
    install --mode 0755 /tmp/lazygit /usr/local/bin/lazygit && \
    ln --symbolic /usr/local/bin/lazygit /usr/local/bin/lzg && \
    lazygit completion bash \
        > /usr/share/bash-completion/completions/lazygit && \
    rm --force /tmp/lazygit.tar.gz /tmp/lazygit && \
    lazygit --version

# Install chezmoi.
RUN curl --fail --silent --show-error --location \
        "https://github.com/twpayne/chezmoi/releases/download/v${CHEZMOI_VERSION}/chezmoi_${CHEZMOI_VERSION}_linux_amd64.tar.gz" \
        --output /tmp/chezmoi.tar.gz && \
    printf "%s  %s" \
        "${CHEZMOI_SHA256}" \
        "/tmp/chezmoi.tar.gz" | sha256sum --check --strict && \
    tar --extract --gzip --file /tmp/chezmoi.tar.gz --directory /tmp && \
    install --mode 0755 /tmp/chezmoi /usr/local/bin/chezmoi && \
    install \
        --mode 0644 \
        /tmp/completions/chezmoi-completion.bash \
        /usr/share/bash-completion/completions/chezmoi && \
    rm --recursive --force \
        /tmp/chezmoi.tar.gz \
        /tmp/chezmoi \
        /tmp/completions && \
    chezmoi --version

# Install oh-my-posh.
RUN curl --fail --silent --show-error --location \
        "https://github.com/JanDeDobbeleer/oh-my-posh/releases/download/v${OHMYPOSH_VERSION}/posh-linux-amd64" \
        --output /tmp/oh-my-posh && \
    printf "%s  %s" \
        "${OHMYPOSH_SHA256}" \
        "/tmp/oh-my-posh" | sha256sum --check --strict && \
    install --mode 0755 /tmp/oh-my-posh /usr/local/bin/oh-my-posh && \
    rm --force /tmp/oh-my-posh && \
    oh-my-posh --version

# Install neovim.
RUN curl --fail --silent --show-error --location \
        "https://github.com/neovim/neovim/releases/download/v${NEOVIM_VERSION}/nvim-linux-x86_64.tar.gz" \
        --output /tmp/nvim-linux-x86_64.tar.gz && \
    printf "%s  %s" \
        "${NEOVIM_SHA256}" \
        "/tmp/nvim-linux-x86_64.tar.gz" | sha256sum --check --strict && \
    tar --extract --gzip --file /tmp/nvim-linux-x86_64.tar.gz --directory /opt && \
    mv /opt/nvim-linux-x86_64 /opt/nvim && \
    ln --symbolic /opt/nvim/bin/nvim /usr/local/bin/nvim && \
    install --directory /usr/local/share/man/man1 && \
    install --mode 0644 \
        /opt/nvim/share/man/man1/nvim.1 \
        /usr/local/share/man/man1/nvim.1 && \
    rm --force /tmp/nvim-linux-x86_64.tar.gz && \
    nvim --version

# Install tree-sitter.
RUN curl --fail --silent --show-error --location \
        "https://github.com/tree-sitter/tree-sitter/releases/download/v${TREESITTER_VERSION}/tree-sitter-cli-linux-x64.zip" \
        --output /tmp/tree-sitter-cli-linux-x64.zip && \
    printf "%s  %s" \
        "${TREESITTER_SHA256}" \
        "/tmp/tree-sitter-cli-linux-x64.zip" | sha256sum --check --strict && \
    unzip /tmp/tree-sitter-cli-linux-x64.zip -d /tmp && \
    install --mode 0755 /tmp/tree-sitter /usr/local/bin/tree-sitter && \
    tree-sitter complete --shell bash \
        > /usr/share/bash-completion/completions/tree-sitter && \
    rm --force /tmp/tree-sitter-cli-linux-x64.zip /tmp/tree-sitter && \
    tree-sitter --version

# Install LanguageTool.
RUN curl --fail --silent --show-error --location \
        "https://languagetool.org/download/LanguageTool-stable.zip" \
        --output /tmp/LanguageTool-stable.zip && \
    printf "%s  %s" \
        "${LANGUAGETOOL_SHA256}" \
        "/tmp/LanguageTool-stable.zip" | sha256sum --check --strict && \
    unzip /tmp/LanguageTool-stable.zip -d /opt && \
    touch /opt/LanguageTool-${LANGUAGETOOL_VERSION}/server.properties

# Install Codex.
RUN curl --fail --silent --show-error --location \
        "https://github.com/openai/codex/releases/download/rust-v${CODEX_VERSION}/codex-package-x86_64-unknown-linux-musl.tar.gz" \
        --output /tmp/codex-package.tar.gz && \
    printf "%s  %s" \
        "${CODEX_PACKAGE_SHA256}" \
        "/tmp/codex-package.tar.gz" | sha256sum --check --strict && \
    mkdir --parents /opt/codex && \
    tar --extract --gzip --file /tmp/codex-package.tar.gz --directory /opt/codex && \
    ln --symbolic /opt/codex/bin/codex /usr/local/bin/codex && \
    ln --symbolic /opt/codex/bin/codex-code-mode-host /usr/local/bin/codex-code-mode-host && \
    codex completion bash \
        > /usr/share/bash-completion/completions/codex && \
    rm --force /tmp/codex-package.tar.gz && \
    codex --version

# Set the default workspace folder and shell.
WORKDIR /workspaces
CMD ["/bin/bash"]
